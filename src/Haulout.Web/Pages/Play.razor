@page "/"
@using Haulout.Web.Services
@using Haulout.Web.Components
@inject GameSession Session
@implements IDisposable

<PageTitle>Haulout</PageTitle>

@if (!Session.IsAboard)
{
    <div class="intro">
        <article class="card">
            <h1>Haulout</h1>
            <p>@string.Join(" ", Session.Briefing.Lines)</p>
            <button class="primary" data-action="go-aboard" @onclick="Session.GoAboard">Go aboard</button>
        </article>
    </div>
}
else
{
    <div class="play">
        <div class="left">
            <div class="stage" data-level-now="@(Session.Level == ViewLevel.Map ? "map" : "closeup")">
                <div class="layer" data-level="map" aria-hidden="@(Map ? null : "true")" inert="@(!Map)" style="opacity:@(Map ? 1 : 0);pointer-events:@(Map ? "auto" : "none")"><Cutaway /></div>
                <div class="layer" data-level="closeup" aria-hidden="@(Map ? "true" : null)" inert="@(Map)" style="opacity:@(Map ? 0 : 1);pointer-events:@(Map ? "none" : "auto")"><CloseUp /></div>
            </div>
            <div class="log"><Logbook /></div>
        </div>
        <div class="right"><ContextPanel /></div>
    </div>
}

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;

    private bool Map => Session.Level == ViewLevel.Map;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnChanged;
}
