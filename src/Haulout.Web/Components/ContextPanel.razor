@using Haulout.Web.Services
@using Haulout.Sim.Play
@inject GameSession Session
@implements IDisposable

<aside class="contextpanel">
    @if (Session.Loss is { } loss)
    {
        <section class="closing">
            <h2>She's on the bottom.</h2>
            @foreach (var line in loss.Lines) { <p>@line</p> }
        </section>
    }
    <div class="top">
        <button class="primary" data-action="start" @onclick="() => Session.TryStart()">Try to start</button>
        @if (Session.Status.EngineRunning)
        {
            <button data-action="stop-engine" @onclick="() => Session.StopEngine()">Stop engine</button>
        }
        @if (string.Equals(Session.Aboard.Place, "Cockpit", StringComparison.OrdinalIgnoreCase))
        {
            <button data-action="pump-bilge" @onclick="() => Session.PumpBilge()">Pump the bilge</button>
        }
        @if (!Session.HasRemoteStartButton)
        {
            <button data-action="buy-remote" @onclick="() => Session.BuyRemoteStartButton()">Buy remote start button (@Session.RemoteStartButtonCostNok NOK)</button>
        }
    </div>

    @{ var unseen = Session.UnseenAlerts; }
    <nav class="tabs">
        <button class="@(Session.ReadinessTab ? "" : "on")" data-tab="here" @onclick="() => Session.ShowTab(false)">Here</button>
        <button class="@(Session.ReadinessTab ? "on" : "")" data-tab="readiness" @onclick="() => Session.ShowTab(true)">Readiness@if (unseen > 0) { <span class="badge" data-badge="alerts" title="The boat has told you something">@unseen</span> }</button>
    </nav>

    @if (Session.ReadinessTab)
    {
        var rd = Session.Readiness;
        var sv = Session.Survey;
        <section class="readiness">
            <p>Day @rd.Day · deadline day @rd.LaunchDeadlineDay (@DaysToGo(rd.DaysToDeadline)) · @rd.BalanceNok NOK left</p>
            <div class="options">
                @if (!sv.Ordered)
                {
                    <div class="option"><button data-action="order-survey" disabled="@rd.Afloat" @onclick="() => Session.OrderSurvey()">Order survey@(SurveyFee(sv))</button></div>
                }
                else
                {
                    <div class="option"><button data-action="read-survey" @onclick="() => Session.ToggleSurvey()">@(Session.SurveyOpen ? "Close survey" : "Read survey")</button></div>
                }
                <div class="option"><button data-action="wait" @onclick="() => Session.Wait(1)">Wait a day</button></div>
                @if (rd.Launched && rd.Afloat)
                {
                    <div class="option"><button data-action="emergency-lift" @onclick="() => Session.EmergencyLift()">Emergency lift (@rd.EmergencyLiftNok NOK)</button></div>
                }
                <div class="option"><button class="primary" data-action="launch" disabled="@rd.Afloat" @onclick="() => Session.Launch()">Launch</button></div>
            </div>

            @if (Session.SurveyOpen && sv.Ordered)
            {
                <article class="letter">
                    @foreach (var line in sv.Opening) { <p>@line</p> }
                    <ol>
                        @foreach (var it in sv.Items)
                        {
                            <li value="@it.Number"><span class="label">@it.Severity</span> @it.Component: @it.Text</li>
                        }
                    </ol>
                    @foreach (var line in sv.Closing) { <p>@line</p> }
                    <p class="faint">@sv.Surveyor</p>
                </article>
            }

            <h3>Open problems</h3>
            @if (rd.Open.Count == 0) { <p class="faint">Nothing known and open.</p> }
            @foreach (var p in rd.Open)
            {
                <div class="problem">
                    <p><strong>@p.Problem</strong> · @p.Component · @p.State</p>
                    <p>now @p.CostNowNok NOK / later @p.CostLaterNok NOK@(p.LaterNote is { Length: > 0 } ln ? " (" + ln + ")" : "")@(p.OnHardOnly ? " · on the hard only" : "")</p>
                    @if (Escalates(p) is { } escalates) { <p class="faint">@escalates</p> }
                    <p class="faint">@p.Consequence</p>
                    @if (p.State == "Deferred")
                    {
                        <button data-action="undefer" @onclick="() => Session.Undefer(p.Problem)">Undefer</button>
                    }
                    else
                    {
                        <button data-action="defer" @onclick="() => Session.Defer(p.Problem)">Defer</button>
                    }
                </div>
            }

            @if (rd.ToInvestigate.Count > 0)
            {
                <h3>To look into</h3>
                @foreach (var t in rd.ToInvestigate) { <p>@t.Component: @t.Note</p> }
            }
            @if (rd.Fixed.Count > 0)
            {
                <h3>Done</h3>
                @foreach (var f in rd.Fixed) { <p class="faint">@f</p> }
            }

            @if (Session.LaunchNarrative is { } launched)
            {
                <section class="closing">
                    <h2>She's in the water.</h2>
                    @foreach (var line in launched) { <p>@line</p> }
                </section>
            }
        </section>
    }
    else
    {

        var aboard = Session.Aboard; var here = aboard.Covers.Where(c => c.Place.Equals(aboard.Place, StringComparison.OrdinalIgnoreCase)).ToList();
    <section class="here">
        <h2 data-place>@aboard.Place</h2>
        @if (here.Count > 0)
        {
            <div class="covers">
                @foreach (var c in here)
                {
                    <button class="cover-toggle" data-cover-toggle="@c.Name" @onclick="() => Session.ClickCover(c.Name)">@c.Name <span class="state">@(c.Removed ? "off" : "in place")</span></button>
                }
            </div>
        }
    </section>

    @if (Session.LastResult is { } r && !ReferenceEquals(r.Narrative, Session.ClosingNarrative))
    {
        <section class="result @(r.Accepted ? "" : "refused")">
            @foreach (var line in r.Narrative)
            {
                <p>@line</p>
            }
            @if (r.Accepted && (r.MinutesTaken > 0 || r.CostNok > 0))
            {
                <p class="cost">@Cost(r)</p>
            }
            @foreach (var f in r.NewlyDiscovered)
            {
                <p class="noted">Noted in the log: @f.Name.</p>
            }
        </section>
    }

    @if (Session.ClosingNarrative is { } closing)
    {
        <section class="closing">
            <h2>She runs.</h2>
            @foreach (var line in closing)
            {
                <p>@line</p>
            }
        </section>
    }

    <section class="selection">
        @if (Session.SelectedComponent is { } id)
        {
            var view = Session.ActionsFor(id);
            if (view.Found)
            {
                var inspect = Session.LastInspectText(id);
                var meter = Session.LastMeterText(id);
                <h2>@view.ComponentName</h2>
                if (aboard.Components.Any(c => c.Flagged && string.Equals(c.Name, view.ComponentName, StringComparison.OrdinalIgnoreCase)))
                {
                    <p class="flagged">Surveyor flagged</p>
                }
                if (aboard.Components.FirstOrDefault(c => string.Equals(c.Name, view.ComponentName, StringComparison.OrdinalIgnoreCase)) is { } fc)
                {
                    <p class="position">@fc.Position</p>
                }
                <div class="known">
                    @if (inspect is not null && !LastIsInspect(inspect)) { <p><span class="label">Inspected:</span> @inspect</p> }
                    @if (meter is not null && !LastIsMeter(meter)) { <p><span class="label">Meter:</span> @meter</p> }
                    @if (inspect is null && meter is null) { <p class="faint">You haven't looked closely yet.</p> }
                </div>
                <div class="options">
                    @foreach (var o in view.Options)
                    {
                        <div class="option">
                            <button data-verb="@o.Verb" disabled="@(!o.Available)" @onclick="() => Session.RunVerb(o.Verb, id, o.Target)"><span class="verb">@o.Label</span>@if (OptionMeta(o) is { Length: > 0 } meta) { <span class="meta">@meta</span> }</button>
                            @if (!o.Available && o.UnavailableReason is { } why)
                            {
                                <p class="why">@why</p>
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <p class="faint">@(Session.Level == ViewLevel.Map ? "Click a place to go there, or a part to look at it." : "Click a cover to take it off, or a part to work on it.")</p>
        }
    </section>
    }
</aside>

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnChanged;

    private static string? Escalates(ReadinessItem p) =>
        (p.LikelyMinDays, p.LikelyMaxDays) is ({ } lo, { } hi)
            ? (lo == hi ? $"Likely to get worse in {lo} {(lo == 1 ? "day" : "days")}." : $"Likely to get worse in {lo}\u2013{hi} days.")
        : p.EscalatesOnLaunch ? "Escalates on launch." : null;

    private static string DaysToGo(int d) =>
        d > 0 ? $"{d} days to go" : d == 0 ? "today" : $"{-d} days past";

    private static string SurveyFee(SurveyReportView sv) => sv.FeeNok > 0 ? $" ({sv.FeeNok} NOK)" : "";

    private static string Duration(int minutes) =>
        minutes >= 60 && minutes % 60 == 0 ? $"{minutes / 60} h" : $"{minutes} min";

    private static string Cost(CommandResult r)
    {
        var parts = new List<string>();
        if (r.MinutesTaken > 0) parts.Add($"+{Duration(r.MinutesTaken)}");
        if (r.CostNok > 0) parts.Add($"{r.CostNok} NOK");
        return string.Join(", ", parts);
    }

    private bool LastIsInspect(string remembered) =>
        Session.LastResult is { Accepted: true, Observation: InspectionView iv } && iv.Text == remembered;

    private bool LastIsMeter(string remembered) =>
        Session.LastResult is { Accepted: true, Observation: MeterReading mr } && mr.Text == remembered;

    private static string OptionMeta(ActionOption o)
    {
        var extra = new List<string>();
        if (o.CostNok > 0) extra.Add($"{o.CostNok} NOK");
        if (o.Minutes > 0) extra.Add(Duration(o.Minutes));
        return string.Join(" · ", extra);
    }
}
