@using Haulout.Web.Services
@using Haulout.Sim.Play
@inject GameSession Session
@implements IDisposable

<aside class="contextpanel">
    @if (Session.Loss is { } loss)
    {
        <section class="closing">
            <h2>She's on the bottom.</h2>
            @foreach (var line in loss.Lines) { <p>@line</p> }
        </section>
    }
    <div class="top">
        <button class="primary" data-action="start" @onclick="() => Session.TryStart()">Try to start</button>
        @if (Session.Status.EngineRunning)
        {
            <button data-action="stop-engine" @onclick="() => Session.StopEngine()">Stop engine</button>
        }
        @if (string.Equals(Session.Aboard.Place, "Cockpit", StringComparison.OrdinalIgnoreCase))
        {
            <button data-action="pump-bilge" @onclick="() => Session.PumpBilge()">Pump the bilge</button>
        }
        @if (!Session.HasRemoteStartButton)
        {
            <button data-action="buy-remote" @onclick="() => Session.BuyRemoteStartButton()">Buy remote start button (@Session.RemoteStartButtonCostNok NOK)</button>
        }
    </div>

    @{ var unseen = Session.UnseenAlerts; }
    <nav class="tabs">
        <button class="@(Session.Tab == PanelTab.Here ? "on" : "")" data-tab="here" @onclick="() => Session.ShowTab(PanelTab.Here)">Here</button>
        <button class="@(Session.Tab == PanelTab.Readiness ? "on" : "")" data-tab="readiness" @onclick="() => Session.ShowTab(PanelTab.Readiness)">Readiness @if (unseen > 0) { <span class="badge" data-badge="alerts" title="The boat has told you something">@unseen</span> }</button>
        <button class="@(Session.Tab == PanelTab.Trip ? "on" : "")" data-tab="trip" @onclick="() => Session.ShowTab(PanelTab.Trip)">Trip</button>
        <button class="@(Session.Tab == PanelTab.Season ? "on" : "")" data-tab="season" @onclick="() => Session.ShowTab(PanelTab.Season)">Season</button>
    </nav>

    @if (Session.Tab == PanelTab.Season)
    {
        var se = Session.Season;
        var sale = Session.Sale;
        <section class="season">
            @if (Session.Closing is { } sold)
            {
                <section class="closing" data-closing>
                    <h2>Sold.</h2>
                    @foreach (var line in sold.Lines) { <p>@line</p> }
                    <p class="cost">Day @sold.Day · @sold.PriceNok NOK · @sold.Days days · @sold.HoursWorked h of your own work · @sold.Trips @(sold.Trips == 1 ? "trip" : "trips") · @sold.Tows @(sold.Tows == 1 ? "tow" : "tows")</p>
                </section>
            }
            @if (Session.LastResult is { } sr && sr.Observation is not ClosingView)
            {
                <section class="result @(sr.Accepted ? "" : "refused")">
                    @foreach (var line in sr.Narrative) { <p>@line</p> }
                    @if (sr.Accepted && sr.Observation is MeterReading { Gap: { } gap }) { <p data-circuit-gap>@Haulout.Prose.Prose.CircuitGapLine(gap)</p> }
                    @if (sr.Accepted && (sr.MinutesTaken > 0 || sr.CostNok > 0)) { <p class="cost">@Cost(sr)</p> }
                </section>
            }
            <p data-season-text>@se.Text</p>

            @if (!sale.Sold)
            {
                <h3>The yard</h3>
                <p>
                    @if (se.BookedDay is { } booked) { <span data-booked>Your slot: day @booked.</span> }
                    else if (se.FirstFreeDay is { } free) { <span data-first-free>First free slot: day @free.</span> }
                    else { <span>The yard is full for the autumn.</span> }
                    Slots run from day @se.SlotsFromDay to day @se.SlotsToDay. Lift @se.LiftNok NOK, winter storage @se.StorageNok NOK@(se.BookedDay is null ? "" : $"; changing the booking costs {se.ChangeFeeNok} NOK"). An emergency lift is @se.EmergencyLiftNok NOK.
                </p>
                <div class="row">
                    @if (Offered(se, "book-haulout"))
                    {
                        <input type="number" data-input="book-day" placeholder="day" @bind="_bookDay" />
                        <button data-action="book-haulout" disabled="@(_bookDay is null)" @onclick="BookClicked">Book</button>
                    }
                    @if (Offered(se, "haul-out"))
                    {
                        <button class="primary" data-action="haul-out" @onclick="() => Session.HaulOut()">Haul out</button>
                    }
                </div>

                <h3>The hull</h3>
                <div class="options">
                    @if (Offered(se, "scrub"))
                    {
                        <div class="option"><button data-action="scrub" @onclick="() => Session.Scrub()">Scrub<span class="meta">from the cockpit, at anchor or a mooring; takes part of it off</span></button></div>
                    }
                    @if (Offered(se, "clean-hull"))
                    {
                        <div class="option"><button data-action="clean-hull" @onclick="() => Session.CleanHull()">Clean hull<span class="meta">on the hard, your own work</span></button></div>
                    }
                    @if (Offered(se, "wash-hull"))
                    {
                        <div class="option"><button data-action="yard-wash" @onclick="() => Session.WashHull()">Yard wash<span class="meta">the yard pressure-washes her; they bill it</span></button></div>
                    }
                </div>

                @if (se.Tasks.Count > 0)
                {
                    <h3>Winter work</h3>
                    @foreach (var task in se.Tasks)
                    {
                        <div class="task" data-task="@task.Command">
                            <p><strong>@task.Name</strong> @if (task.Done) { <span class="done" data-done>done</span> }</p>
                            <p class="faint">@Duration(task.Minutes)@(task.CostNok > 0 ? $" · {task.CostNok} NOK" : "") · @task.Risk</p>
                            <div class="row">
                                @if (!task.Done && (TaskVerb(task.Command) is not { } verb || Offered(se, verb)))
                                {
                                    <button data-action="@task.Command" @onclick="() => Session.RunLayupTask(task.Command)">@task.Name</button>
                                }
                                @if (task.Command == "battery ashore")
                                {
                                    @if (Offered(se, "battery-aboard")) { <button data-action="battery-aboard" @onclick="() => Session.BatteryAboard()">Battery aboard</button> }
                                    @if (Offered(se, "winter-charger")) { <button data-action="charger" @onclick="() => Session.WinterCharger()">Charger</button> }
                                }
                            </div>
                        </div>
                    }
                }
                @if (Offered(se, "wait-until-spring"))
                {
                    <div class="options">
                        <div class="option"><button data-action="wait-until-spring" @onclick="() => Session.WaitUntilSpring()">Wait until spring</button></div>
                    </div>
                }

                <h3>The sale</h3>
                @if (sale.Letter is { } letter)
                {
                    <article class="letter" data-letter>
                        <p class="faint">@letter.Broker, day @letter.Day</p>
                        @foreach (var l in letter.Lines) { <p>@l.Text: @(l.Nok > 0 ? "+" : "")@l.Nok NOK</p> }
                        <p><strong>She is worth about @letter.ValueNok NOK.</strong>@(letter.AskNok is { } a ? $" You are asking {a} NOK." : "")</p>
                        @foreach (var line in letter.Text) { <p class="faint">@line</p> }
                    </article>
                }
                @if (Offered(se, "list-for-sale"))
                {
                    <div class="row">
                        <input type="number" data-input="ask" placeholder="ask, NOK" @bind="_ask" />
                        <button data-action="list-for-sale" disabled="@(_ask is null or <= 0)" @onclick="ListClicked">List for sale</button>
                    </div>
                }
                @foreach (var v in sale.Viewings)
                {
                    <div class="viewing @(v.Open ? "" : "lapsed")" data-viewing="@v.Number">
                        <p><strong>Viewing @v.Number</strong> · day @v.Day · their value @v.ValueNok NOK · offer @v.OfferNok NOK @(v.Open ? $"open until day {v.HoldsUntilDay}" : "(lapsed)")</p>
                        @foreach (var f in v.Findings) { <p class="faint">@f</p> }
                        @if (v.Findings.Count == 0) { <p class="faint">Their surveyor found nothing.</p> }
                        @if (v.Open && Offered(se, "accept-offer"))
                        {
                            <button data-action="accept-offer" @onclick="() => Session.AcceptOffer(v.Number)">Accept @v.OfferNok NOK</button>
                        }
                    </div>
                }
                @if (Offered(se, "keep"))
                {
                    <div class="options">
                        <div class="option"><button data-action="keep" @onclick="() => Session.Keep()">Keep<span class="meta">carry her into next season</span></button></div>
                    </div>
                }
            }
        </section>
    }
    else if (Session.Tab == PanelTab.Trip)
    {
        var trip = Session.Trip;
        <section class="trip">
            @if (Session.TripResult is { } tr)
            {
                <section class="closing">
                    <h2>@(tr.Towed ? "Towed in." : tr.TurnedBack ? "Back where she started." : "Made port.")</h2>
                    @foreach (var line in tr.Lines) { <p>@line</p> }
                    <p class="cost">@tr.Destination · @Duration(tr.Minutes)@(tr.MoneySpentNok > 0 ? $", {tr.MoneySpentNok} NOK" : "")</p>
                </section>
            }
            @if (Session.LastResult is { } lr && lr.Observation is not TripResultView)
            {
                <section class="result @(lr.Accepted ? "" : "refused")">
                    @foreach (var line in lr.Narrative) { <p>@line</p> }
                    @if (lr.Accepted && lr.Observation is MeterReading { Gap: { } gap }) { <p data-circuit-gap>@Haulout.Prose.Prose.CircuitGapLine(gap)</p> }
                    @if (lr.Accepted && (lr.MinutesTaken > 0 || lr.CostNok > 0)) { <p class="cost">@Cost(lr)</p> }
                </section>
            }
            @if (trip.AtSea)
            {
                <p data-trip-text>@trip.Text</p>
                <p class="faint">@trip.From to @trip.To · @trip.PositionNm.ToString("0.0") nm made good, @trip.RemainingNm.ToString("0.0") nm to go · @trip.Mode@(trip.NearestShelter is { Length: > 0 } sh ? " · shelter: " + sh : "")</p>
                <div class="options">
                    <div class="option"><button class="primary" data-action="continue" @onclick="() => Session.Continue()">Continue</button></div>
                    <div class="option"><button data-action="motor" @onclick="() => Session.Motor()">Motor</button></div>
                    <div class="option"><button data-action="sail" @onclick="() => Session.Sail()">Sail</button></div>
                    <div class="option"><button data-action="heave-to" @onclick="() => Session.HeaveTo()">Heave to</button></div>
                    <div class="option"><button data-action="anchor" disabled="@(!trip.CanAnchor)" @onclick="() => Session.Anchor()">Anchor</button></div>
                    <div class="option"><button data-action="turn-back" @onclick="() => Session.TurnBack()">Turn back</button></div>
                    <div class="option"><button data-action="call-tow" @onclick="() => Session.CallTow()">Call tow</button></div>
                </div>
            }
            else
            {
                var plan = Session.PlanTrip();
                var inv = Session.Inventory;
                <h3>@plan.From to @plan.To</h3>
                <p>@plan.DistanceNm.ToString("0.0") nm · @plan.Estimate</p>
                @foreach (var f in plan.Forecast) { <p class="faint">Day @f.Day: @f.Text</p> }
                @if (plan.Risks.Count > 0)
                {
                    <h3>Known problems at sea</h3>
                    @foreach (var risk in plan.Risks)
                    {
                        <p><strong>@risk.Problem</strong> · @risk.Component: @risk.AtSea@(risk.Spare is { } sp ? (risk.SpareAboard ? $" (spare {sp} aboard)" : $" (no {sp} aboard)") : "")</p>
                    }
                }
                @if (plan.SparesAboard.Count > 0) { <p class="faint">Spares aboard: @string.Join(", ", plan.SparesAboard)</p> }
                @if (plan.SparesMissing.Count > 0) { <p class="faint">Missing: @string.Join(", ", plan.SparesMissing)</p> }
                @foreach (var b in plan.Blockers) { <p class="why" data-blocker>@b</p> }
                <div class="options">
                    <div class="option"><button class="primary" data-action="depart" disabled="@(plan.Blockers.Count > 0)" title="@string.Join(" ", plan.Blockers)" @onclick="() => Session.Depart()">Depart</button></div>
                </div>
                <h3>Spares</h3>
                @foreach (var l in inv.Aboard) { <p class="faint">@l.Name@(l.Tool ? "" : " x" + l.Count)</p> }
                @if (inv.Aboard.Count == 0) { <p class="faint">Nothing aboard.</p> }
                <div class="options">
                    @foreach (var l in inv.ForSale)
                    {
                        <div class="option"><button data-action="buy" data-item="@l.Name" @onclick="() => Session.Buy(l.Name)">Buy @l.Name (@l.PriceNok NOK)</button></div>
                    }
                </div>
            }
        </section>
    }
    else if (Session.Tab == PanelTab.Readiness)
    {
        var rd = Session.Readiness;
        var sv = Session.Survey;
        <section class="readiness">
            <p>Day @rd.Day · @(rd.SeasonLead ?? $"deadline day {rd.LaunchDeadlineDay} ({DaysToGo(rd.DaysToDeadline)})") · @MoneyWords.BalanceShort(rd.BalanceNok)</p>
            <div class="options">
                @if (!sv.Ordered)
                {
                    <div class="option"><button data-action="order-survey" disabled="@rd.Afloat" @onclick="() => Session.OrderSurvey()">Order survey@(SurveyFee(sv))</button></div>
                }
                else
                {
                    <div class="option"><button data-action="read-survey" @onclick="() => Session.ToggleSurvey()">@(Session.SurveyOpen ? "Close survey" : "Read survey")</button></div>
                }
                <div class="option"><button data-action="wait" @onclick="() => Session.Wait(1)">Wait a day</button></div>
                @if (rd.Launched && rd.Afloat)
                {
                    <div class="option"><button data-action="emergency-lift" @onclick="() => Session.EmergencyLift()">Emergency lift (@rd.EmergencyLiftNok NOK)</button></div>
                }
                <div class="option"><button class="primary" data-action="launch" disabled="@rd.Afloat" @onclick="() => Session.Launch()">Launch</button></div>
            </div>

            @if (Session.SurveyOpen && sv.Ordered)
            {
                <article class="letter">
                    @foreach (var line in sv.Opening) { <p>@line</p> }
                    <ol>
                        @foreach (var it in sv.Items)
                        {
                            <li value="@it.Number"><span class="label">@it.Severity</span> @it.Component: @it.Text</li>
                        }
                    </ol>
                    @foreach (var line in sv.Closing) { <p>@line</p> }
                    <p class="faint">@sv.Surveyor</p>
                </article>
            }

            <h3>Open problems</h3>
            @if (rd.Open.Count == 0) { <p class="faint">Nothing known and open.</p> }
            @foreach (var p in rd.Open)
            {
                <div class="problem">
                    <p><strong>@p.Problem</strong> · @p.Component · @p.State</p>
                    <p>now @p.CostNowNok NOK / later @p.CostLaterNok NOK@(p.LaterNote is { Length: > 0 } ln ? " (" + ln + ")" : "")@(p.OnHardOnly ? " · on the hard only" : "")</p>
                    @if (Escalates(p) is { } escalates) { <p class="faint">@escalates</p> }
                    <p class="faint">@p.Consequence</p>
                    @if (p.State == "Deferred")
                    {
                        <button data-action="undefer" @onclick="() => Session.Undefer(p.Problem)">Undefer</button>
                    }
                    else
                    {
                        <button data-action="defer" @onclick="() => Session.Defer(p.Problem)">Defer</button>
                    }
                </div>
            }

            @if (rd.ToInvestigate.Count > 0)
            {
                <h3>To look into</h3>
                @foreach (var t in rd.ToInvestigate) { <p>@t.Component: @t.Note</p> }
            }
            @if (rd.Fixed.Count > 0)
            {
                <h3>Done</h3>
                @foreach (var f in rd.Fixed) { <p class="faint">@f</p> }
            }

            @if (Session.LaunchNarrative is { } launched)
            {
                <section class="closing">
                    <h2>She's in the water.</h2>
                    @foreach (var line in launched) { <p>@line</p> }
                </section>
            }
        </section>
    }
    else
    {

        var aboard = Session.Aboard; var here = aboard.Covers.Where(c => c.Place.Equals(aboard.Place, StringComparison.OrdinalIgnoreCase)).ToList();
    <section class="here">
        <h2 data-place>@aboard.Place</h2>
        @if (here.Count > 0)
        {
            <div class="covers">
                @foreach (var c in here)
                {
                    <button class="cover-toggle" data-cover-toggle="@c.Name" @onclick="() => Session.ClickCover(c.Name)">@c.Name <span class="state">@(c.Removed ? "off" : "in place")</span></button>
                }
            </div>
        }
    </section>

    @if (Session.LastResult is { } r && !ReferenceEquals(r.Narrative, Session.ClosingNarrative))
    {
        <section class="result @(r.Accepted ? "" : "refused")">
            @foreach (var line in r.Narrative)
            {
                <p>@line</p>
            }
            @if (r.Accepted && (r.MinutesTaken > 0 || r.CostNok > 0))
            {
                <p class="cost">@Cost(r)</p>
            }
            @foreach (var f in r.NewlyDiscovered)
            {
                <p class="noted">Noted in the log: @f.Name.</p>
            }
        </section>
    }

    @if (Session.ClosingNarrative is { } closing)
    {
        <section class="closing">
            <h2>She runs.</h2>
            @foreach (var line in closing)
            {
                <p>@line</p>
            }
        </section>
    }

    <section class="selection">
        @if (Session.SelectedComponent is { } id)
        {
            var view = Session.ActionsFor(id);
            if (view.Found)
            {
                var inspect = Session.LastInspectText(id);
                var meter = Session.LastMeterText(id);
                <h2>@view.ComponentName</h2>
                if (aboard.Components.Any(c => c.Flagged && string.Equals(c.Name, view.ComponentName, StringComparison.OrdinalIgnoreCase)))
                {
                    <p class="flagged">Surveyor flagged</p>
                }
                if (aboard.Components.FirstOrDefault(c => string.Equals(c.Name, view.ComponentName, StringComparison.OrdinalIgnoreCase)) is { } fc)
                {
                    <p class="position">@fc.Position</p>
                }
                <div class="known">
                    @if (inspect is not null && !LastIsInspect(inspect)) { <p><span class="label">Inspected:</span> @inspect</p> }
                    @if (meter is not null && !LastIsMeter(meter)) { <p><span class="label">Meter:</span> @meter</p> }
                    @if (inspect is null && meter is null) { <p class="faint">You haven't looked closely yet.</p> }
                </div>
                <div class="options">
                    @foreach (var o in view.Options)
                    {
                        <div class="option">
                            <button data-verb="@o.Verb" disabled="@(!o.Available)" @onclick="() => Session.RunVerb(o.Verb, id, o.Target)"><span class="verb">@o.Label</span>@if (OptionMeta(o) is { Length: > 0 } meta) { <span class="meta">@meta</span> }</button>
                            @if (!o.Available && o.UnavailableReason is { } why)
                            {
                                <p class="why">@why</p>
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <p class="faint">@(Session.Level == ViewLevel.Map ? "Click a place to go there, or a part to look at it." : "Click a cover to take it off, or a part to work on it.")</p>
        }
    </section>
    }
</aside>

@code {
    private int? _bookDay;
    private int? _ask;

    /// <summary>The season action the sim would accept now (it gives the same refusal the command does); everything else stays hidden.</summary>
    private static bool Offered(SeasonView se, string verb) => se.Actions is null || se.Actions.Any(a => a.Verb == verb && a.Available);

    /// <summary>The action behind a winter task's button, or null for a task that has none of its own (the oil change).</summary>
    private static string? TaskVerb(string command) => command switch
    {
        "winterise" => "winterise-engine",
        "fill tank" => "fill-tank",
        "battery ashore" => "battery-ashore",
        "fit cover" => "fit-winter-cover",
        _ => null,
    };

    private void BookClicked()
    {
        if (_bookDay is { } d) Session.BookHaulout(d);
    }

    private void ListClicked()
    {
        if (_ask is { } a) Session.ListForSale(a);
    }

    protected override void OnInitialized() => Session.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnChanged;

    private static string? Escalates(ReadinessItem p) =>
        (p.LikelyMinDays, p.LikelyMaxDays) is ({ } lo, { } hi)
            ? (lo == hi ? $"Likely to get worse in {lo} {(lo == 1 ? "day" : "days")}." : $"Likely to get worse in {lo}\u2013{hi} days.")
        : p.EscalatesOnLaunch ? "Escalates on launch." : null;

    private static string DaysToGo(int d) =>
        d > 0 ? $"{d} days to go" : d == 0 ? "today" : $"{-d} days past";

    private static string SurveyFee(SurveyReportView sv) => sv.FeeNok > 0 ? $" ({sv.FeeNok} NOK)" : "";

    private static string Duration(int minutes) =>
        minutes >= 60 && minutes % 60 == 0 ? $"{minutes / 60} h" : $"{minutes} min";

    private static string Cost(CommandResult r)
    {
        var parts = new List<string>();
        if (r.MinutesTaken > 0) parts.Add($"+{Duration(r.MinutesTaken)}");
        if (r.CostNok > 0) parts.Add($"{r.CostNok} NOK");
        return string.Join(", ", parts);
    }

    private bool LastIsInspect(string remembered) =>
        Session.LastResult is { Accepted: true, Observation: InspectionView iv } && iv.Text == remembered;

    private bool LastIsMeter(string remembered) =>
        Session.LastResult is { Accepted: true, Observation: MeterReading mr } && mr.Text == remembered;

    private static string OptionMeta(ActionOption o)
    {
        var extra = new List<string>();
        if (o.CostNok > 0) extra.Add($"{o.CostNok} NOK");
        if (o.Minutes > 0) extra.Add(Duration(o.Minutes));
        return string.Join(" · ", extra);
    }
}
