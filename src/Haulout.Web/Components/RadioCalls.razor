@using Haulout.Web.Services
@inject GameSession Session

@* The VHF at the chart table: who she can call. The ferry's own call is answered from the card at the top of the panel. *@
<div class="calls" data-radio>
    <span class="label">VHF</span>
    <button data-action="call-harbour" @onclick='() => Session.Call("harbour")'>Call the harbour</button>
    <button data-action="call-coast-radio" @onclick='() => Session.Call("coast radio")'>Call the coast radio</button>
</div>
