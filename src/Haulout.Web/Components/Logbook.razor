@using Haulout.Web.Services
@inject GameSession Session
@implements IDisposable

<section class="logbook">
    @{ var status = Session.Status; var entries = Session.Log.Entries; }
    <header>Day @status.Day · @status.TimeOfDay · time spent @(status.MinutesSpent / 60) h @(status.MinutesSpent % 60) min · money spent @status.MoneySpentNok NOK</header>
    <div class="scroll">
        <ol>
            @if (entries.Count == 0)
            {
                <li class="empty">The logbook is empty.</li>
            }
            @foreach (var (e, i) in entries.Select((e, i) => (e, i)))
            {
                <li @key="i" class="@Kind(e)">
                    <span class="stamp">D@(e.Day) @e.TimeOfDay</span>
                    <span class="text">@e.Text</span>
                    @if (e.CostNok > 0) { <span class="amount">@e.CostNok NOK</span> }
                </li>
            }
        </ol>
    </div>
</section>

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnChanged;

    private static string Kind(Haulout.Sim.Play.LogEntry e) =>
        e.Text.StartsWith("Found:") ? "found"
        : e.CostNok > 0 || e.Text.StartsWith("Bought") || e.Text.StartsWith("Replaced") ? "receipt"
        : "";
}
