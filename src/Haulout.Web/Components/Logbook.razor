@using Haulout.Web.Services
@inject GameSession Session
@implements IDisposable

<section class="logbook">
    @{ var status = Session.Status; var entries = Session.Log.Entries; }
    <header>Day @status.Day · @status.TimeOfDay · worked @(status.MinutesSpent / 60) h @(status.MinutesSpent % 60) min · money spent @Session.Money(status.MoneySpentNok) · @MoneyWords.BalanceShort(status.BalanceNok, Session.Currency) @if (status.Weather is not null) { <span class="weather"> · @status.Weather</span> }</header>
    @if (status.Week is { Length: > 0 } weekLine || status.Fuel is { Length: > 0 }) { <p class="weekline" data-week-line>@status.Week@(status.Week is { Length: > 0 } && status.Fuel is { Length: > 0 } ? " · " : "")@status.Fuel</p> }
    @if (status.Season is { Length: > 0 } seasonLine) { <p class="seasonline" data-season-line>@seasonLine</p> }
    <div class="scroll">
        <ol>
            @if (entries.Count == 0)
            {
                <li class="empty">The logbook is empty.</li>
            }
            @foreach (var (e, i) in entries.Select((e, i) => (e, i)))
            {
                <li @key="i" class="@Kind(e)">
                    <span class="stamp">D@(e.Day) @e.TimeOfDay</span>
                    <span class="text">@e.Text</span>
                    @if (e.Document is not null && !e.Document.StartsWith("letter", StringComparison.Ordinal)) { <button class="read" data-action="read-document" @onclick="() => ReadDocument(e.Document)">read</button> }
                    @if (e.CostNok > 0) { <span class="amount">@Session.Money(e.CostNok)</span> }
                </li>
            }
        </ol>
    </div>
</section>

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;

    private void ReadDocument(string document)
    {
        if (document.StartsWith("season ", StringComparison.Ordinal) && int.TryParse(document.AsSpan(7), out var n)) Session.ShowSeasonPage(n);
        else Session.ShowSurvey();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnChanged;

    private static string Kind(Haulout.Sim.Play.LogEntry e) =>
        e.Alert ? "alert"
        : e.Document is not null ? "document"
        : e.Text.StartsWith("Found:") ? "found"
        : e.CostNok > 0 || e.Text.StartsWith("Bought") || e.Text.StartsWith("Replaced") ? "receipt"
        : "";
}
