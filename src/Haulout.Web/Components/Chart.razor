@implements IDisposable
@inject GameSession Session
@using System.Globalization
@using Haulout.Sim.Play
@using Haulout.Web.Art
@using Haulout.Web.Services

@{
    var ch = Session.Chart;
    var boat = ch.Boat;
    var portAt = ch.Ports.ToDictionary(p => p.Name, StringComparer.OrdinalIgnoreCase);
    var windTo = (WindDegrees(ch.Wind.From) + 180) % 360;
}

<figure class="chartfig">
    <svg class="chart" viewBox="@ChartGeometry.ViewBox" xmlns="http://www.w3.org/2000/svg"
         role="group" aria-label="Chart of the archipelago" data-chart>
        @* paper and water *@
        <rect class="c-sheet" x="0" y="0" width="@ChartGeometry.Width" height="@ChartGeometry.Height" />
        @foreach (var s in ChartGeometry.Shallows) { <path class="c-shoal" d="@s.D" /> }
        @foreach (var l in ChartGeometry.Lands) { <path class="c-@l.Class" d="@l.D" /> }
        @foreach (var s in ChartGeometry.Soundings) { <g><text class="c-sounding" x="@F(s.X)" y="@F(s.Y)">@s.Depth</text></g> }
        @foreach (var n in ChartGeometry.IslandNames) { <g><text class="c-island @(n.OnLand ? "on-land" : "on-water")" x="@F(n.X)" y="@F(n.Y)">@n.Text</text></g> }

        @* rose and scale *@
        @foreach (var d in ChartGeometry.Rose) { <path class="c-@d.Class" d="@d.D" /> }
        <text class="c-note c-mid" x="@F(ChartGeometry.RoseNorthLabel.X)" y="@F(ChartGeometry.RoseNorthLabel.Y)">@ChartGeometry.RoseNorthLabel.Text</text>
        @foreach (var d in ChartGeometry.ScaleBar) { <path class="c-@d.Class" d="@d.D" /> }
        @foreach (var t in ChartGeometry.ScaleLabels) { <g><text class="c-note c-mid" x="@F(t.X)" y="@F(t.Y)">@t.Text</text></g> }

        @* routes, faint pencil; shelters named *@
        @foreach (var r in ch.Routes)
        {
            if (portAt.TryGetValue(r.From, out var a) && portAt.TryGetValue(r.To, out var b))
            {
                <line class="c-route" x1="@F(X(a.EastNm))" y1="@F(Y(a.NorthNm))" x2="@F(X(b.EastNm))" y2="@F(Y(b.NorthNm))">
                    <title>@r.From to @r.To, @F1(r.DistanceNm) nm on @r.CourseDeg.ToString("000")</title>
                </line>
            }
            @foreach (var sh in r.Shelters) { @ShelterMark(sh) }
        }

        @* the planned route, darker, with its estimate *@
        @if (ch.Plan is { } plan && portAt.TryGetValue(plan.From, out var pa) && portAt.TryGetValue(plan.To, out var pb))
        {
            double x1 = X(pa.EastNm), y1 = Y(pa.NorthNm), x2 = X(pb.EastNm), y2 = Y(pb.NorthNm);
            double mx = Math.Clamp((x1 + x2) / 2, 150, 850), my = (y1 + y2) / 2 - 16;
            var motor = F1(plan.MotorHours) + " h motor";
            var sail = plan.SailHours is { } sh2 ? " · " + F1(sh2) + " h sail" : "";
            <line class="c-plan" x1="@F(x1)" y1="@F(y1)" x2="@F(x2)" y2="@F(y2)" data-plan>
                <title>@plan.Estimate</title>
            </line>
            <g><text class="c-plan-label c-mid" x="@F(mx)" y="@F(my)" data-plan-label>@(F1(plan.DistanceNm) + " nm · " + motor + sail)<title>@plan.Estimate</title></text></g>
        }

        @* earlier tracks, faded *@
        @foreach (var t in ch.EarlierTracks)
        {
            <polyline class="c-track earlier" points="@Points(t)" data-track="earlier">
                <title>Day @t.Day: @t.From to @t.To, @t.Outcome</title>
            </polyline>
        }

        @* the passage under way *@
        @if (ch.Track is { } cur)
        {
            <polyline class="c-track current" points="@Points(cur)" data-track="current">
                <title>Day @cur.Day: @cur.From to @cur.To, @cur.Outcome</title>
            </polyline>
            @foreach (var fx in cur.Fixes)
            {
                var hasEvents = fx.Events.Count > 0;
                var tip = $"Hour {fx.Hour}, {fx.Mode}" + (hasEvents ? ": " + string.Join(" ", fx.Events) : "");
                <g class="c-fix" data-fix="@fx.Hour" transform="translate(@F(X(fx.EastNm)) @F(Y(fx.NorthNm)))">
                    <circle class="c-fix-dot" r="2.6" />
                    @if (hasEvents && fx.Hour > 0) { <circle class="c-fix-ring" r="8" data-fix-event /> }
                    <circle class="c-hit" r="9" />
                    <title>@tip</title>
                </g>
            }
        }

        @* ports *@
        @foreach (var p in ch.Ports)
        {
            var px = X(p.EastNm);
            var py = Y(p.NorthNm);
            var label = ChartGeometry.PortLabels.TryGetValue(p.Name, out var spot) ? spot : new ChartGeometry.LabelSpot(14, -12, "start");
            var tip = p.IsHere ? p.Name + ", she lies here" : p.Reachable ? $"{p.Name}, {F1(p.DistanceNm)} nm on {p.BearingDeg:000}. Click to plan the trip." : $"{p.Name}, {F1(p.DistanceNm)} nm on {p.BearingDeg:000}";
            var cls = "c-port" + (p.IsHere ? " here" : "") + (p.Reachable ? " reachable" : "");
            <g class="@cls" data-port="@p.Name" transform="translate(@F(px) @F(py))"
               role="@(p.Reachable ? "button" : null)" tabindex="@(p.Reachable ? 0 : null)"
               aria-label="@(p.Reachable ? "Plan a trip to " + p.Name : p.Name)"
               @onclick="() => OnPort(p)" @onkeydown="e => OnKey(e, p)">
                <title>@tip</title>
                <circle class="c-hit" r="24" />
                <circle class="c-port-ring" r="7" />
                <circle class="c-port-dot" r="2.5" />
                <text class="c-port-name" x="@F(label.Dx)" y="@F(label.Dy)" text-anchor="@label.Anchor">@p.Name</text>
                @{
                    var glyphs = new List<string>();
                    if (p.Yard) glyphs.Add(GlyphCrane);
                    if (p.Shop) glyphs.Add(GlyphShop);
                    if (p.Fuel) glyphs.Add(GlyphPump);
                    if (p.Anchorage) glyphs.Add(GlyphAnchor);
                    double gw = 17, total = glyphs.Count * gw;
                    double gx = label.Anchor == "end" ? label.Dx - total : label.Anchor == "middle" ? label.Dx - total / 2 : label.Dx;
                    double gy = label.Dy + 5;
                }
                @for (int i = 0; i < glyphs.Count; i++)
                {
                    <path class="c-glyph" d="@glyphs[i]" transform="translate(@F(gx + i * gw) @F(gy))" />
                }
            </g>
        }

        @* the boat *@
        <g class="c-boat" data-boat transform="translate(@F(X(boat.EastNm)) @F(Y(boat.NorthNm)))">
            <title>@ch.Here</title>
            @if (boat.Sunk)
            {
                <g data-wreck>
                    <path class="c-wreck-hull" d="M-11,3 C-6,-4 6,-4 11,3 L8,7 L-8,7 Z" />
                    <path class="c-wreck-x" d="M-8,-10 L8,6 M8,-10 L-8,6" />
                </g>
            }
            else
            {
                <g transform="rotate(@boat.HeadingDeg.ToString(CultureInfo.InvariantCulture))">
                    <path class="c-hull" d="M0,-14 C6,-6 7,5 4,12 L-4,12 C-7,5 -6,-6 0,-14 Z" />
                    <path class="c-mast" d="M0,-8 L0,8" />
                </g>
            }
        </g>

        @* weather: rain greys the paper, the wind sits in the corner *@
        @if (ch.Wind.Rain)
        {
            <rect class="c-rain" x="0" y="0" width="@ChartGeometry.Width" height="@ChartGeometry.Height" data-rain />
            <rect class="c-rain-hatch" x="0" y="0" width="@ChartGeometry.Width" height="@ChartGeometry.Height" fill="url(#c-rain-pattern)" />
        }
        <g class="c-wind" data-wind transform="translate(18 540)">
            <title>@ch.Wind.Text</title>
            <rect class="c-wind-plate" x="0" y="0" width="190" height="48" rx="3" />
            <g transform="translate(26 24) rotate(@windTo.ToString(CultureInfo.InvariantCulture))">
                <path class="c-wind-arrow" d="M0,-16 L0,15 M-6,-8 L0,-16 L6,-8" />
            </g>
            <text class="c-wind-force" x="54" y="30">@("F" + ch.Wind.Force)</text>
            <text class="c-wind-from" x="96" y="30">@(ch.Wind.From)@(ch.Wind.Rain ? ", rain" : "")</text>
        </g>

        <defs>
            <pattern id="c-rain-pattern" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(70)">
                <line class="c-rain-line" x1="0" y1="0" x2="0" y2="9" />
            </pattern>
        </defs>
    </svg>
    <figcaption class="chart-here" data-chart-here>@ch.Here</figcaption>
</figure>

@code {
    private const string GlyphCrane = "M2,12 L2,1 L11,1 M9,1 L9,6 M0,12 L6,12";
    private const string GlyphShop = "M1,5 L11,5 L11,12 L1,12 Z M1,5 L3,1 L9,1 L11,5";
    private const string GlyphPump = "M2,12 L2,1 L8,1 L8,12 M0,12 L10,12 M8,4 L11,4 L11,9 M3.5,3 L6.5,3 L6.5,5.5 L3.5,5.5 Z";
    private const string GlyphAnchor = "M6,2.5 L6,12 M3,5 L9,5 M1.5,8.5 C2,13 10,13 10.5,8.5 M6,0.5 m-1.4,0 a1.4,1.4 0 1 0 2.8,0 a1.4,1.4 0 1 0 -2.8,0";

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;

    // coordinate conversion and layout only: the sim answers everything else
    private static double X(double east) => ChartGeometry.X(east);
    private static double Y(double north) => ChartGeometry.Y(north);
    private static string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);

    private static string Points(ChartTrack t) =>
        string.Join(" ", t.Fixes.Select(f => F(X(f.EastNm)) + "," + F(Y(f.NorthNm))));

    /// <summary>The compass word the wind blows FROM, in degrees (north 0, clockwise by 45).</summary>
    private static int WindDegrees(string from)
    {
        var w = from.Replace("-", "").Replace(" ", "").ToLowerInvariant();
        return w switch
        {
            "north" => 0, "northeast" => 45, "east" => 90, "southeast" => 135,
            "south" => 180, "southwest" => 225, "west" => 270, "northwest" => 315,
            _ => 0,
        };
    }

    private void OnPort(ChartPort p)
    {
        if (p.Reachable) Session.PlanTo(p.Name);
    }

    private void OnKey(KeyboardEventArgs e, ChartPort p)
    {
        if (e.Key is "Enter" or " " or "Spacebar") OnPort(p);
    }

    private RenderFragment ShelterMark(ChartShelter sh) => __builder =>
    {
        var x = X(sh.EastNm);
        var y = Y(sh.NorthNm);
        var centre = ChartGeometry.SkerryCentres.TryGetValue(sh.Name, out var c) ? c : (X: x, Y: y);
        var spot = ChartGeometry.ShelterLabels.TryGetValue(sh.Name, out var s) ? s : new ChartGeometry.LabelSpot(8, 20, "start");
        <g class="c-shelter" data-shelter="@sh.Name">
            <title>@sh.Name, shelter @F1(sh.AtNm) nm along the route</title>
            <path class="c-shelter-mark" d="@($"M{F(x)},{F(y - 5)} L{F(x + 5)},{F(y)} L{F(x)},{F(y + 5)} L{F(x - 5)},{F(y)} Z")" />
            <text class="c-shelter-name" x="@F(centre.X + spot.Dx)" y="@F(centre.Y + spot.Dy)" text-anchor="@spot.Anchor">@sh.Name</text>
        </g>
    };
}
